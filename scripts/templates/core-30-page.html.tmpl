<!-- wp:html -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ==========================================================================
   {client_name} — Core 30 service page styles v2 (auto-generated from template)
   Page: {page_slug}
   Generated: {generated_at}
   ========================================================================== */

/* Hide the duplicate WordPress page title (the page-header / entry-title) so
   the hero H1 in our HTML is the only top-of-page heading. Theme classes vary;
   this list covers the common patterns. If the page title still shows after
   publish, inspect the page and add the specific class your theme uses. */
.single-page .page-header,
.page .entry-header,
.page-header,
.entry-header h1.entry-title,
h1.entry-title,
.elementor-page-title,
.page-title-bar,
.page-title-banner,
.dtr-page-title-main,
.dtr-page-title-section,
.breadcrumb-area + .page-header {{ display: none !important; }}

/* Theme wrapper padding override — our hero is designed to start at the viewport edge.
   The Ambery theme adds 150px top/bottom padding to #dtr-main-wrapper which creates
   white space above/below our hero. Kill it on pages that include this stylesheet. */
#dtr-main-wrapper,
.dtr-main-wrapper,
.dtr-content-area,
main.dtr-content-area,
.dtr-primary-section {{
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}}

/* Break out of WordPress theme container — page uses full viewport width.
   No padding/margin overrides on theme wrappers (those caused header layout
   regressions). The remaining gap between header and hero is a theme-level
   setting and gets fixed in Theme Customizer, not here. */
.{css_prefix}-corepage {{
  position: relative;
  width: 100vw;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  margin-top: 0;
  margin-bottom: 0;
  color: #1f2937;
  line-height: 1.8;
  font-size: 18px;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  letter-spacing: -0.005em;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}}
.{css_prefix}-corepage * {{ box-sizing: border-box; }}
.{css_prefix}-corepage h1, .{css_prefix}-corepage h2, .{css_prefix}-corepage h3 {{ color: {heading_color}; line-height: 1.25; font-family: inherit; }}
.{css_prefix}-corepage h1 {{ font-size: 2.75rem; margin: 0 0 1.25rem; font-weight: 800; letter-spacing: -0.025em; }}
.{css_prefix}-corepage h2 {{ font-size: 2.15rem; margin: 0 0 1.5rem; font-weight: 800; letter-spacing: -0.02em; }}
.{css_prefix}-corepage h3 {{ font-size: 1.3rem; margin: 0 0 0.6rem; font-weight: 700; letter-spacing: -0.01em; }}
.{css_prefix}-corepage p {{ margin: 0 0 1.4rem; }}
.{css_prefix}-corepage strong {{ color: {heading_color}; font-weight: 700; }}
.{css_prefix}-corepage a {{ color: {primary_color}; text-decoration: none; font-weight: 500; }}
.{css_prefix}-corepage a:hover {{ text-decoration: underline; }}
.{css_prefix}-corepage ul {{ padding-left: 1.5rem; margin: 0 0 1.4rem; }}
.{css_prefix}-corepage ul li {{ margin-bottom: 0.65rem; }}
.{css_prefix}-corepage em {{ color: #475569; font-style: italic; }}

.{css_prefix}-section {{ padding: 5rem 1.5rem; }}
.{css_prefix}-section-inner {{ max-width: 1200px; margin: 0 auto; }}
/* Centered section heading with yellow accent bar underneath (modern flourish) */
.{css_prefix}-section-inner > h2 {{
  text-align: center;
  margin-bottom: 1rem;
}}
.{css_prefix}-section-inner > h2::after {{
  content: "";
  display: block;
  width: 56px;
  height: 4px;
  background: {accent_yellow};
  margin: 0.85rem auto 0;
  border-radius: 2px;
}}
/* Centered intro paragraph below the section heading */
.{css_prefix}-section-inner > h2 + p {{
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
  font-size: 1.1rem;
  color: #475569;
  margin-bottom: 2.5rem;
}}
.{css_prefix}-section-inner > p {{ max-width: 820px; font-size: 1.05rem; }}

/* Section-specific overrides ============================================ */
/* Left-aligned heading + intro (e.g. Section 2 "What troubleshooting means") */
.{css_prefix}-section-inner > h2.{css_prefix}-heading-left {{
  text-align: left;
}}
.{css_prefix}-section-inner > h2.{css_prefix}-heading-left::after {{
  margin-left: 0;
  margin-right: auto;
}}
.{css_prefix}-section-inner > h2.{css_prefix}-heading-left + p {{
  text-align: left;
  max-width: 820px;
  margin-left: 0;
  margin-right: 0;
  font-size: 1.05rem;
  color: #1f2937;
}}

/* Closing note — full-width centered paragraph at the bottom of a section
   (e.g. Section 3's "If your home falls...", Section 6's "If pricing this...") */
.{css_prefix}-closing-note {{
  text-align: center;
  max-width: 820px !important;
  margin: 2.5rem auto 0 !important;
  font-size: 1.1rem;
  color: #475569;
  font-style: italic;
}}

/* Two-column section layout — text left, sidebar widget right (used in Section 2) */
.{css_prefix}-section-2col {{ display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; align-items: start; }}
.{css_prefix}-section-2col .{css_prefix}-section-text > h2 {{ margin-bottom: 1rem; }}

/* Quick-reference accordion sidebar — modern boxy element for Section 2 */
.{css_prefix}-quick-ref {{ background: #f5f7fa; border-radius: 16px; padding: 1.85rem; border: 1px solid #e6e9f0; }}
.{css_prefix}-quick-ref-label {{ display: inline-block; background: #fef6dc; color: #b58400; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em; padding: 0.35rem 0.65rem; border-radius: 6px; margin-bottom: 0.85rem; text-transform: uppercase; }}
.{css_prefix}-quick-ref h3 {{ font-size: 1.2rem; color: {heading_color}; margin: 0 0 0.5rem; line-height: 1.3; }}
.{css_prefix}-quick-ref-intro {{ font-size: 0.95rem; color: #475569; margin-bottom: 1.25rem; }}
.{css_prefix}-quick-ref details {{ background: #fff; border-radius: 10px; padding: 0.9rem 1.1rem; margin-bottom: 0.65rem; border: 1px solid #e6e9f0; transition: border-color 0.15s, box-shadow 0.15s; }}
.{css_prefix}-quick-ref details:hover {{ border-color: {primary_color}; box-shadow: 0 2px 8px rgba(10,37,64,0.06); }}
.{css_prefix}-quick-ref details[open] {{ border-color: {primary_color}; background: #fafcff; }}
.{css_prefix}-quick-ref summary {{ cursor: pointer; font-weight: 700; color: {heading_color}; font-size: 0.98rem; line-height: 1.4; padding-right: 0.5rem; list-style: none; display: flex; align-items: flex-start; gap: 0.55rem; }}
.{css_prefix}-quick-ref summary::-webkit-details-marker {{ display: none; }}
.{css_prefix}-quick-ref summary::before {{ content: "\25B6"; color: {accent_yellow}; font-size: 0.7rem; flex-shrink: 0; margin-top: 0.35rem; transition: transform 0.15s; }}
.{css_prefix}-quick-ref details[open] summary::before {{ transform: rotate(90deg); }}
.{css_prefix}-quick-ref details[open] summary {{ margin-bottom: 0.6rem; }}
.{css_prefix}-quick-ref details p {{ margin: 0; font-size: 0.92rem; line-height: 1.65; color: #475569; }}
.{css_prefix}-quick-ref-footer {{ margin-top: 1rem; font-size: 0.88rem; color: #475569; text-align: center; }}
.{css_prefix}-quick-ref-footer a {{ font-weight: 600; }}
@media (max-width: 900px) {{
  .{css_prefix}-section-2col {{ grid-template-columns: 1fr; gap: 2rem; }}
  .{css_prefix}-quick-ref {{ padding: 1.5rem; }}
}}
.{css_prefix}-section--white {{ background: #fff; }}
.{css_prefix}-section--gray {{ background: #f5f7fa; }}

/* Hero — 3-stop gradient (dark→mid→bright) + radial highlight overlay for shine */
.{css_prefix}-hero {{
  background: linear-gradient(135deg, {hero_gradient_dark} 0%, {hero_gradient_mid} 65%, {hero_gradient_bright} 100%);
  color: #fff;
  padding: 5rem 1.5rem;
  position: relative;
  overflow: hidden;
}}
.{css_prefix}-hero::before {{
  content: "";
  position: absolute;
  top: -40%;
  right: -10%;
  width: 55%;
  height: 180%;
  background: radial-gradient(ellipse at center, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 65%);
  pointer-events: none;
  z-index: 0;
}}
.{css_prefix}-hero h1 {{ color: #fff; font-size: 3rem; position: relative; z-index: 1; }}
/* H1 eyebrow — small yellow uppercase keyword line above the main hero H2.
   Gives the page a proper SEO H1 while keeping the H2 as the visual focus. */
.{css_prefix}-hero h1.{css_prefix}-hero-eyebrow {{
  color: {accent_yellow};
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin: 0 0 0.85rem;
  line-height: 1.3;
  position: relative;
  z-index: 1;
}}
.{css_prefix}-hero h2.{css_prefix}-hero-heading {{ color: #fff; font-size: 2.75rem; line-height: 1.15; margin: 0 0 1rem; font-weight: 800; letter-spacing: -0.025em; position: relative; z-index: 1; }}
@media (max-width: 768px) {{ .{css_prefix}-hero h2.{css_prefix}-hero-heading {{ font-size: 2rem; }} }}
.{css_prefix}-hero .{css_prefix}-subheading {{ font-size: 1.25rem; color: #e7eefe; margin-bottom: 1.75rem; max-width: 720px; line-height: 1.5; position: relative; z-index: 1; }}
.{css_prefix}-hero-inner {{ max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: center; position: relative; z-index: 1; }}
.{css_prefix}-hero-image {{ background: rgba(255,255,255,0.08); border-radius: 12px; min-height: 320px; display: flex; align-items: center; justify-content: center; color: {accent_yellow}; font-weight: 600; padding: 1.5rem; text-align: center; border: 2px dashed rgba(255,255,255,0.3); }}
/* Belt-and-suspenders: keep rounded corners on the hero image even after
   Imagify converts PNGs to WebP and wraps the <img> in a <picture> element
   (the inline border-radius on the img doesn't always survive that wrap). */
.{css_prefix}-corepage .{css_prefix}-hero-image img,
.{css_prefix}-corepage .{css_prefix}-hero-image picture,
.{css_prefix}-corepage .{css_prefix}-hero-image picture img {{
  border-radius: 20px !important;
  -webkit-border-radius: 20px !important;
}}
/* Same picture-wrapper fix for the About portrait. Without this, the
   bottom corners of the about image go square after Imagify wraps the img
   in a picture element, because the picture wrapper itself isn't rounded.
   Mirror of the hero rule above. */
.{css_prefix}-corepage .{css_prefix}-about-image img,
.{css_prefix}-corepage .{css_prefix}-about-image picture,
.{css_prefix}-corepage .{css_prefix}-about-image picture img {{
  border-radius: 20px !important;
  -webkit-border-radius: 20px !important;
  display: block !important;
}}

.{css_prefix}-cta-row {{ display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; }}
.{css_prefix}-btn {{ display: inline-block; padding: 1rem 2rem; border-radius: 8px; font-weight: 700; font-size: 1.05rem; text-decoration: none !important; transition: transform 0.1s, box-shadow 0.1s, background 0.15s; }}
.{css_prefix}-btn-primary {{ background: {accent_yellow}; color: {navy} !important; }}
.{css_prefix}-btn-primary:hover {{ background: #ffc107; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(245,180,0,0.3); }}
.{css_prefix}-btn-secondary {{ background: rgba(255,255,255,0.1); color: #fff !important; border: 2px solid #fff; }}
.{css_prefix}-btn-secondary:hover {{ background: #fff; color: {navy} !important; }}
.{css_prefix}-btn-large {{ padding: 1.2rem 2.5rem; font-size: 1.15rem; }}

/* Three-column pattern grid — equal heights via stretch */
.{css_prefix}-pattern-grid {{ display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-top: 1.75rem; align-items: stretch; }}
.{css_prefix}-pattern-card {{ background: #fff; padding: 1.85rem; border-radius: 14px; border-top: 3px solid {accent_yellow}; box-shadow: 0 1px 3px rgba(10,37,64,0.05), 0 1px 2px rgba(10,37,64,0.03); display: flex; flex-direction: column; transition: transform 0.18s ease, box-shadow 0.18s ease; }}
.{css_prefix}-pattern-card:hover {{ transform: translateY(-4px); box-shadow: 0 8px 24px rgba(10,37,64,0.1), 0 2px 6px rgba(10,37,64,0.05); }}
/* House icon at top of each pattern card */
.{css_prefix}-pattern-card::before {{
  content: "";
  display: block;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background-color: {pattern_card_icon_bg};
  background-image: url("{pattern_card_icon_svg}");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 26px 26px;
  margin-bottom: 1rem;
}}
.{css_prefix}-pattern-card h3 {{ color: {heading_color}; font-size: 1.15rem; margin-bottom: 0.6rem; }}
.{css_prefix}-pattern-card em {{ display: block; margin-bottom: 0.85rem; color: {primary_color}; font-style: normal; font-weight: 600; font-size: 0.9rem; letter-spacing: 0.01em; }}
.{css_prefix}-pattern-card p {{ font-size: 1rem; line-height: 1.7; margin-bottom: 1rem; }}
.{css_prefix}-pattern-card p:last-child {{ margin-bottom: 0; }}

/* Specific problems grid — 3-column on desktop, tighter cards */
.{css_prefix}-problems {{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 1.75rem; align-items: stretch; }}
.{css_prefix}-problem {{ background: #fff; padding: 1.65rem; border-radius: 14px; border-top: 3px solid {primary_color}; box-shadow: 0 1px 3px rgba(10,37,64,0.05), 0 1px 2px rgba(10,37,64,0.03); display: flex; flex-direction: column; transition: transform 0.18s ease, box-shadow 0.18s ease; }}
.{css_prefix}-problem:hover {{ transform: translateY(-4px); box-shadow: 0 8px 24px rgba(10,37,64,0.1), 0 2px 6px rgba(10,37,64,0.05); }}
/* Lightning bolt icon at top of each problem card (electrical theme) */
.{css_prefix}-problem::before {{
  content: "";
  display: block;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background-color: {problem_card_icon_bg};
  background-image: url("{problem_card_icon_svg}");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 22px 22px;
  margin-bottom: 0.85rem;
}}
.{css_prefix}-problem h3 {{ color: {heading_color}; font-size: 1.15rem; }}
.{css_prefix}-problem p {{ font-size: 1rem; line-height: 1.7; }}
.{css_prefix}-problem h3 {{ color: {navy}; }}

/* Process steps with badges */
.{css_prefix}-process-list {{ display: grid; gap: 1.5rem; margin-top: 1.25rem; }}
.{css_prefix}-process-step {{ display: grid; grid-template-columns: 72px 1fr; gap: 1.5rem; align-items: start; }}
.{css_prefix}-step-badge {{ background: {primary_color}; color: #fff; font-size: 1.5rem; font-weight: 800; width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(37,117,252,0.3); }}
.{css_prefix}-step-body h3 {{ margin-bottom: 0.4rem; }}

/* Pricing block */
.{css_prefix}-pricing {{ background: #fff; padding: 2.25rem; border-radius: 12px; border-left: 6px solid {accent_yellow}; box-shadow: 0 4px 16px rgba(18,48,117,0.08); margin-top: 1.5rem; }}
.{css_prefix}-pricing ul {{ list-style: none; padding: 0; margin: 0; }}
.{css_prefix}-pricing ul li {{ padding: 1rem 0; border-bottom: 1px solid #eef0f4; }}
.{css_prefix}-pricing ul li:last-child {{ border-bottom: none; }}
.{css_prefix}-pricing-note {{ background: #f5f7fa; padding: 1rem 1.25rem; border-radius: 6px; margin-top: 1rem; font-style: italic; color: #555; }}

/* About — equal heights so image fills text-side */
.{css_prefix}-about-grid {{ display: grid; grid-template-columns: 1fr 2fr; gap: 2.5rem; align-items: stretch; }}
.{css_prefix}-about-image {{ background: linear-gradient(135deg, {hero_gradient_dark} 0%, {primary_color} 100%); border-radius: 14px; min-height: 380px; display: flex; align-items: center; justify-content: center; color: {accent_yellow}; font-weight: 600; padding: 1.5rem; text-align: center; border: 2px dashed rgba(245,180,0,0.4); }}
/* Narrow the About text block so lines wrap into more lines per paragraph.
   Paragraphs grow naturally taller with the original tight 1.4rem gaps
   between them; the block fills the image height without paragraph-gap
   spreading. Image stays the same size. */
.{css_prefix}-about-text {{ max-width: 640px; }}
.{css_prefix}-about-text > *:last-child {{ margin-bottom: 0; }}

/* Neighborhoods + map — equal heights so the map fills the list-side */
.{css_prefix}-neighborhoods-grid {{ display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: stretch; }}
.{css_prefix}-neighborhoods ul {{ padding-left: 0; list-style: none; margin-bottom: 1.4rem; }}
.{css_prefix}-neighborhoods ul li {{ padding: 0.7rem 0; border-bottom: 1px dashed #d8dce5; }}
.{css_prefix}-neighborhoods ul li:last-child {{ border-bottom: none; }}
.{css_prefix}-map {{ background: #f5f7fa; border-radius: 14px; min-height: 380px; display: flex; align-items: center; justify-content: center; color: #777; text-align: center; padding: 1rem; border: 1px solid #e6e9f0; }}

/* Related services grid */
.{css_prefix}-related-grid {{ display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; margin-top: 1.75rem; }}
.{css_prefix}-related-card {{ background: #fff; padding: 1.5rem 1.25rem; border-radius: 12px; text-align: center; border: 1px solid #e6e9f0; transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s; }}
.{css_prefix}-related-card:hover {{ border-color: {accent_yellow}; transform: translateY(-4px); box-shadow: 0 8px 24px rgba(10,37,64,0.1); }}
.{css_prefix}-related-card a {{ display: block; color: {navy} !important; font-weight: 700; text-decoration: none !important; }}

/* FAQ accordion */
.{css_prefix}-faq {{ margin-top: 1.75rem; }}
.{css_prefix}-faq details {{ background: #fff; padding: 1.6rem 1.75rem; border-radius: 12px; margin-bottom: 1rem; border: 1px solid #e6e9f0; transition: border-color 0.15s; }}
.{css_prefix}-faq details:hover {{ border-color: {primary_color}; }}
.{css_prefix}-faq summary {{ cursor: pointer; font-weight: 700; color: {navy}; font-size: 1.1rem; padding-right: 1rem; }}
.{css_prefix}-faq summary::marker {{ color: {accent_yellow}; }}
.{css_prefix}-faq details[open] summary {{ margin-bottom: 0.85rem; }}
.{css_prefix}-faq details[open] {{ border-color: {primary_color}; }}
.{css_prefix}-faq p {{ margin: 0.5rem 0 0; }}

/* Final CTA — same 3-stop gradient + radial highlight as hero, for visual bookending */
.{css_prefix}-final-cta {{
  text-align: center;
  padding: 5rem 1.5rem;
  background: linear-gradient(135deg, {hero_gradient_dark} 0%, {hero_gradient_mid} 65%, {hero_gradient_bright} 100%);
  color: #fff;
  position: relative;
  overflow: hidden;
}}
.{css_prefix}-final-cta::before {{
  content: "";
  position: absolute;
  top: -40%;
  right: -10%;
  width: 55%;
  height: 180%;
  background: radial-gradient(ellipse at center, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 65%);
  pointer-events: none;
  z-index: 0;
}}
.{css_prefix}-final-cta > * {{ position: relative; z-index: 1; }}
.{css_prefix}-final-cta h2 {{ color: #fff; margin-bottom: 1rem; font-size: 2.4rem; }}
.{css_prefix}-final-cta p {{ color: #e7eefe; font-size: 1.2rem; max-width: 720px; margin: 0 auto 2rem; }}
.{css_prefix}-final-cta .{css_prefix}-cta-row {{ justify-content: center; }}
.{css_prefix}-phone-large {{ display: block; font-size: 2.5rem; font-weight: 800; color: {accent_yellow} !important; margin: 1rem 0 1.5rem; text-decoration: none !important; letter-spacing: -0.02em; }}

/* Mobile breakpoint */
@media (max-width: 768px) {{
  .{css_prefix}-corepage {{ font-size: 16px; }}
  .{css_prefix}-corepage h1 {{ font-size: 2rem; }}
  .{css_prefix}-corepage h2 {{ font-size: 1.6rem; }}
  .{css_prefix}-section {{ padding: 3rem 1.25rem; }}
  .{css_prefix}-hero {{ padding: 3rem 1.25rem; }}
  .{css_prefix}-hero h1 {{ font-size: 2.1rem; }}
  .{css_prefix}-hero-inner {{ grid-template-columns: 1fr; gap: 1.5rem; }}
  .{css_prefix}-hero-image {{ min-height: 200px; order: -1; }}
  .{css_prefix}-pattern-grid {{ grid-template-columns: 1fr; }}
  .{css_prefix}-problems {{ grid-template-columns: 1fr; }}
  /* v16 mobile-breakpoint fixes: collapse the 3 grids that were missing here */
  .{css_prefix}-about-grid {{ grid-template-columns: 1fr; }}
  .{css_prefix}-neighborhoods-grid {{ grid-template-columns: 1fr; }}
  .{css_prefix}-related-grid {{ grid-template-columns: 1fr 1fr; }}
}}
@media (max-width: 1100px) and (min-width: 769px) {{
  .{css_prefix}-problems {{ grid-template-columns: 1fr 1fr; }}
  .{css_prefix}-about-grid {{ grid-template-columns: 1fr; }}
  .{css_prefix}-neighborhoods-grid {{ grid-template-columns: 1fr; }}
  .{css_prefix}-related-grid {{ grid-template-columns: 1fr 1fr; }}
  .{css_prefix}-process-step {{ grid-template-columns: 52px 1fr; gap: 1rem; }}
  .{css_prefix}-step-badge {{ width: 48px; height: 48px; font-size: 1.2rem; }}
  .{css_prefix}-phone-large {{ font-size: 1.8rem; }}
  .{css_prefix}-final-cta h2 {{ font-size: 1.8rem; }}
  .{css_prefix}-cta-row {{ flex-direction: column; }}
  .{css_prefix}-btn {{ text-align: center; }}
}}
</style>

<div class="{css_prefix}-corepage">

  <!-- =================== SECTION 1: Hero =================== -->
  <section class="{css_prefix}-hero">
    <div class="{css_prefix}-hero-inner">
      <div class="{css_prefix}-hero-text">
        <h1 class="{css_prefix}-hero-eyebrow">{hero_eyebrow}</h1>
        <h2 class="{css_prefix}-hero-heading">{hero_heading}</h2>
        <p class="{css_prefix}-subheading">{hero_subheading}</p>
        <div class="{css_prefix}-cta-row">
          <a href="tel:{phone_tel}" class="{css_prefix}-btn {css_prefix}-btn-primary">Call {phone_display}</a>
          <a href="{contact_page_path}" class="{css_prefix}-btn {css_prefix}-btn-secondary">{secondary_cta_label}</a>
        </div>
      </div>
{hero_image_block}
    </div>
  </section>

  <!-- =================== SECTION 2: What X means =================== -->
  <section class="{css_prefix}-section {css_prefix}-section--white">
    <div class="{css_prefix}-section-inner {css_prefix}-section-2col">
      <div class="{css_prefix}-section-text">
        <h2 class="{css_prefix}-heading-left">{what_it_means_heading}</h2>
{what_it_means_paragraphs_html}      </div>
      <aside class="{css_prefix}-quick-ref">
        <span class="{css_prefix}-quick-ref-label">Quick Reference</span>
        <h3>{quick_ref_heading}</h3>
        <p class="{css_prefix}-quick-ref-intro">{quick_ref_intro}</p>

{quick_ref_items_html}
