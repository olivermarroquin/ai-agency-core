  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin: 0 0 0.85rem;
  line-height: 1.3;
  position: relative;
  z-index: 1;
}
.evp-hero h2.evp-hero-heading { color: #fff; font-size: 2.75rem; line-height: 1.15; margin: 0 0 1rem; font-weight: 800; letter-spacing: -0.025em; position: relative; z-index: 1; }
@media (max-width: 768px) { .evp-hero h2.evp-hero-heading { font-size: 2rem; } }
.evp-hero .evp-subheading { font-size: 1.25rem; color: #e7eefe; margin-bottom: 1.75rem; max-width: 720px; line-height: 1.5; position: relative; z-index: 1; }
.evp-hero-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: center; position: relative; z-index: 1; }
.evp-hero-image { background: rgba(255,255,255,0.08); border-radius: 12px; min-height: 320px; display: flex; align-items: center; justify-content: center; color: #f5b400; font-weight: 600; padding: 1.5rem; text-align: center; border: 2px dashed rgba(255,255,255,0.3); }
/* Belt-and-suspenders: keep rounded corners on the hero image even after
   Imagify converts PNGs to WebP and wraps the <img> in a <picture> element
   (the inline border-radius on the img doesn't always survive that wrap). */
.evp-corepage .evp-hero-image img,
.evp-corepage .evp-hero-image picture,
.evp-corepage .evp-hero-image picture img {
  border-radius: 20px !important;
  -webkit-border-radius: 20px !important;
}
/* Same picture-wrapper fix for the About portrait. Without this, the
   bottom corners of the about image go square after Imagify wraps the img
   in a picture element, because the picture wrapper itself isn't rounded.
   Mirror of the hero rule above. */
.evp-corepage .evp-about-image img,
.evp-corepage .evp-about-image picture,
.evp-corepage .evp-about-image picture img {
  border-radius: 20px !important;
  -webkit-border-radius: 20px !important;
  display: block !important;
}

.evp-cta-row { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; }
.evp-btn { display: inline-block; padding: 1rem 2rem; border-radius: 8px; font-weight: 700; font-size: 1.05rem; text-decoration: none !important; transition: transform 0.1s, box-shadow 0.1s, background 0.15s; }
.evp-btn-primary { background: #f5b400; color: #123075 !important; }
