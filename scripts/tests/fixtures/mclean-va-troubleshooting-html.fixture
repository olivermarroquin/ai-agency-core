.evp-quick-ref details { background: #fff; border-radius: 10px; padding: 0.9rem 1.1rem; margin-bottom: 0.65rem; border: 1px solid #e6e9f0; transition: border-color 0.15s, box-shadow 0.15s; }
.evp-quick-ref details:hover { border-color: #0871bc; box-shadow: 0 2px 8px rgba(10,37,64,0.06); }
.evp-quick-ref details[open] { border-color: #0871bc; background: #fafcff; }
.evp-quick-ref summary { cursor: pointer; font-weight: 700; color: #0a2540; font-size: 0.98rem; line-height: 1.4; padding-right: 0.5rem; list-style: none; display: flex; align-items: flex-start; gap: 0.55rem; }
.evp-quick-ref summary::-webkit-details-marker { display: none; }
.evp-quick-ref summary::before { content: "\25B6"; color: #f5b400; font-size: 0.7rem; flex-shrink: 0; margin-top: 0.35rem; transition: transform 0.15s; }
.evp-quick-ref details[open] summary::before { transform: rotate(90deg); }
.evp-quick-ref details[open] summary { margin-bottom: 0.6rem; }
.evp-quick-ref details p { margin: 0; font-size: 0.92rem; line-height: 1.65; color: #475569; }
.evp-quick-ref-footer { margin-top: 1rem; font-size: 0.88rem; color: #475569; text-align: center; }
