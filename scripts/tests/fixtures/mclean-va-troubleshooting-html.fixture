/* Three-column pattern grid — equal heights via stretch */
.evp-pattern-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-top: 1.75rem; align-items: stretch; }
.evp-pattern-card { background: #fff; padding: 1.85rem; border-radius: 14px; border-top: 3px solid #f5b400; box-shadow: 0 1px 3px rgba(10,37,64,0.05), 0 1px 2px rgba(10,37,64,0.03); display: flex; flex-direction: column; transition: transform 0.18s ease, box-shadow 0.18s ease; }
.evp-pattern-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(10,37,64,0.1), 0 2px 6px rgba(10,37,64,0.05); }
/* House icon at top of each pattern card */
.evp-pattern-card::before {
  content: "";
  display: block;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background-color: #fef6dc;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23f5b400'><path d='M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z'/></svg>");
