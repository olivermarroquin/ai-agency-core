      <div class="evp-about-grid">
        <div class="evp-about-image" style="background:none; border:none; padding:0; min-height:0; overflow:hidden; border-radius:20px;">
          <img src="https://evelectric.pro/wp-content/uploads/2026/05/mclean-va-troubleshooting-about-PLACEHOLDER.png"
