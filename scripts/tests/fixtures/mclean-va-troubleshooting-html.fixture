/* Specific problems grid — 3-column on desktop, tighter cards */
.evp-problems { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 1.75rem; align-items: stretch; }
.evp-problem { background: #fff; padding: 1.65rem; border-radius: 14px; border-top: 3px solid #0871bc; box-shadow: 0 1px 3px rgba(10,37,64,0.05), 0 1px 2px rgba(10,37,64,0.03); display: flex; flex-direction: column; transition: transform 0.18s ease, box-shadow 0.18s ease; }
.evp-problem:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(10,37,64,0.1), 0 2px 6px rgba(10,37,64,0.05); }
/* Lightning bolt icon at top of each problem card (electrical theme) */
.evp-problem::before {
  content: "";
  display: block;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background-color: #e6f1fb;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%230871bc'><path d='M13 2L4.09 12.97 11 12 11 22l8.91-10.97L13 12V2z'/></svg>");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 22px 22px;
  margin-bottom: 0.85rem;
}
.evp-problem h3 { color: #0a2540; font-size: 1.15rem; }
.evp-problem p { font-size: 1rem; line-height: 1.7; }
.evp-problem h3 { color: #123075; }

/* Process steps with badges */
.evp-process-list { display: grid; gap: 1.5rem; margin-top: 1.25rem; }
.evp-process-step { display: grid; grid-template-columns: 72px 1fr; gap: 1.5rem; align-items: start; }
.evp-step-badge { background: #0871bc; color: #fff; font-size: 1.5rem; font-weight: 800; width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(37,117,252,0.3); }
.evp-step-body h3 { margin-bottom: 0.4rem; }

/* Pricing block */
.evp-pricing { background: #fff; padding: 2.25rem; border-radius: 12px; border-left: 6px solid #f5b400; box-shadow: 0 4px 16px rgba(18,48,117,0.08); margin-top: 1.5rem; }
.evp-pricing ul { list-style: none; padding: 0; margin: 0; }
.evp-pricing ul li { padding: 1rem 0; border-bottom: 1px solid #eef0f4; }
.evp-pricing ul li:last-child { border-bottom: none; }
.evp-pricing-note { background: #f5f7fa; padding: 1rem 1.25rem; border-radius: 6px; margin-top: 1rem; font-style: italic; color: #555; }

/* About — equal heights so image fills text-side */
.evp-about-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 2.5rem; align-items: stretch; }
.evp-about-image { background: linear-gradient(135deg, #022840 0%, #0871bc 100%); border-radius: 14px; min-height: 380px; display: flex; align-items: center; justify-content: center; color: #f5b400; font-weight: 600; padding: 1.5rem; text-align: center; border: 2px dashed rgba(245,180,0,0.4); }
/* Narrow the About text block so lines wrap into more lines per paragraph.
   Paragraphs grow naturally taller with the original tight 1.4rem gaps
   between them; the block fills the image height without paragraph-gap
   spreading. Image stays the same size. */
.evp-about-text { max-width: 640px; }
.evp-about-text > *:last-child { margin-bottom: 0; }

/* Neighborhoods + map — equal heights so the map fills the list-side */
.evp-neighborhoods-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: stretch; }
.evp-neighborhoods ul { padding-left: 0; list-style: none; margin-bottom: 1.4rem; }
.evp-neighborhoods ul li { padding: 0.7rem 0; border-bottom: 1px dashed #d8dce5; }
.evp-neighborhoods ul li:last-child { border-bottom: none; }
.evp-map { background: #f5f7fa; border-radius: 14px; min-height: 380px; display: flex; align-items: center; justify-content: center; color: #777; text-align: center; padding: 1rem; border: 1px solid #e6e9f0; }

/* Related services grid */
.evp-related-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; margin-top: 1.75rem; }
.evp-related-card { background: #fff; padding: 1.5rem 1.25rem; border-radius: 12px; text-align: center; border: 1px solid #e6e9f0; transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s; }
.evp-related-card:hover { border-color: #f5b400; transform: translateY(-4px); box-shadow: 0 8px 24px rgba(10,37,64,0.1); }
.evp-related-card a { display: block; color: #123075 !important; font-weight: 700; text-decoration: none !important; }

/* FAQ accordion */
.evp-faq { margin-top: 1.75rem; }
.evp-faq details { background: #fff; padding: 1.6rem 1.75rem; border-radius: 12px; margin-bottom: 1rem; border: 1px solid #e6e9f0; transition: border-color 0.15s; }
.evp-faq details:hover { border-color: #0871bc; }
.evp-faq summary { cursor: pointer; font-weight: 700; color: #123075; font-size: 1.1rem; padding-right: 1rem; }
.evp-faq summary::marker { color: #f5b400; }
.evp-faq details[open] summary { margin-bottom: 0.85rem; }
.evp-faq details[open] { border-color: #0871bc; }
.evp-faq p { margin: 0.5rem 0 0; }

/* Final CTA — same 3-stop gradient + radial highlight as hero, for visual bookending */
.evp-final-cta {
  text-align: center;
  padding: 5rem 1.5rem;
  background: linear-gradient(135deg, #022840 0%, #0871bc 65%, #1591d9 100%);
  color: #fff;
  position: relative;
  overflow: hidden;
}
.evp-final-cta::before {
  content: "";
  position: absolute;
  top: -40%;
  right: -10%;
  width: 55%;
  height: 180%;
  background: radial-gradient(ellipse at center, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 65%);
  pointer-events: none;
  z-index: 0;
}
.evp-final-cta > * { position: relative; z-index: 1; }
.evp-final-cta h2 { color: #fff; margin-bottom: 1rem; font-size: 2.4rem; }
.evp-final-cta p { color: #e7eefe; font-size: 1.2rem; max-width: 720px; margin: 0 auto 2rem; }
.evp-final-cta .evp-cta-row { justify-content: center; }
.evp-phone-large { display: block; font-size: 2.5rem; font-weight: 800; color: #f5b400 !important; margin: 1rem 0 1.5rem; text-decoration: none !important; letter-spacing: -0.02em; }

/* Mobile breakpoint */
@media (max-width: 768px) {
  .evp-corepage { font-size: 16px; }
  .evp-corepage h1 { font-size: 2rem; }
  .evp-corepage h2 { font-size: 1.6rem; }
  .evp-section { padding: 3rem 1.25rem; }
  .evp-hero { padding: 3rem 1.25rem; }
  .evp-hero h1 { font-size: 2.1rem; }
  .evp-hero-inner { grid-template-columns: 1fr; gap: 1.5rem; }
  .evp-hero-image { min-height: 200px; order: -1; }
  .evp-pattern-grid { grid-template-columns: 1fr; }
  .evp-problems { grid-template-columns: 1fr; }
  /* v16 mobile-breakpoint fixes: collapse the 3 grids that were missing here */
  .evp-about-grid { grid-template-columns: 1fr; }
  .evp-neighborhoods-grid { grid-template-columns: 1fr; }
  .evp-related-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 1100px) and (min-width: 769px) {
  .evp-problems { grid-template-columns: 1fr 1fr; }
  .evp-about-grid { grid-template-columns: 1fr; }
  .evp-neighborhoods-grid { grid-template-columns: 1fr; }
  .evp-related-grid { grid-template-columns: 1fr 1fr; }
  .evp-process-step { grid-template-columns: 52px 1fr; gap: 1rem; }
  .evp-step-badge { width: 48px; height: 48px; font-size: 1.2rem; }
  .evp-phone-large { font-size: 1.8rem; }
  .evp-final-cta h2 { font-size: 1.8rem; }
  .evp-cta-row { flex-direction: column; }
  .evp-btn { text-align: center; }
