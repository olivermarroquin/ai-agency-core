  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23f5b400'><path d='M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z'/></svg>");
