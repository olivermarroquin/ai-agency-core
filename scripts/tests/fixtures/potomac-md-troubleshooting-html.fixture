    {
      "@type": "FAQPage",
      "@id": "https://evelectric.pro/electrical-troubleshooting-potomac-md/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does pricing work for electrical troubleshooting in Potomac, MD?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We come to the house, look at the actual work, and give a written estimate before any repair starts. Diagnostic visits include most minor on-the-spot repairs. Major repairs get a separate written estimate. No charge for the diagnostic visit in our primary service area."
          }
        },
        {
          "@type": "Question",
          "name": "How quickly can you come out for a troubleshooting call in Potomac?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Same-day or next-day in most cases during weekday business hours. Potomac is about 18 miles from our Fairfax Blvd office — roughly 25–35 minutes via the Capital Beltway and River Road. If your situation is urgent — burning smell, sparking, warm walls — we will triage you to the earliest available slot and tell you what to shut off in the meantime."
          }
        },
        {
          "@type": "Question",
          "name": "What is included in a troubleshooting visit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A real diagnostic — not a guess. We use a multimeter, circuit tracer, AFCI/GFCI tester, and IR thermal camera if heat is suspected. We open panels, test circuits at rest and under load, trace the fault to its source, then explain what we found in plain English before any repair starts."
          }
        },
        {
          "@type": "Question",
          "name": "When should I call an electrician versus trying to fix it myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Call an electrician if you smell burning, see sparking, feel warm walls or warm switch plates, have a breaker that trips daily, or have lost power to part of the house without a clear cause. Resetting a tripped breaker once is fine. Resetting it three times in a row is a fire risk."
          }
        },
        {
          "@type": "Question",
          "name": "What is the most common electrical problem in Potomac homes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Panel capacity issues in estate homes with decades of additions. Potomac's housing stock consists primarily of large homes on generous lots — from 1960s–1970s colonials in Potomac Manors with original 200-amp panels now serving expanded structures, to 1980s luxury homes in Avenel and River Falls where pool equipment, multiple HVAC zones, and home automation consume available capacity, to estate properties along Glen Road with complex multi-panel configurations. The second most common call is voltage drop and flickering lights — caused by long service-entrance runs inherent to estate-lot properties where the PEPCO transformer may be hundreds of feet from the home."
          }
        },
        {
          "@type": "Question",
          "name": "Do you handle EV charger problems?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. EV charging puts continuous high-amp draw on circuits that Potomac's estate homes were not originally wired for. If your charger throttles, trips a breaker, or warms the outlet, the cause is almost always upstream — a feeder, a breaker, or a connection that cannot sustain the load. We diagnose the cause and either repair it or quote you for the right circuit."
          }
        },
        {
          "@type": "Question",
          "name": "Are you licensed and insured?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Ahmad holds a Master Electrician license issued by the Commonwealth of Virginia — the state's highest electrician credential. EV Electric Services is fully insured. We are happy to provide proof of license and insurance on request before any work begins."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer 24/7 emergency service?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer after-hours service when needed, but we don't market ourselves as a 24/7 emergency company. Most residential troubleshooting is handled fastest by booking the earliest weekday or weekend appointment. If you have a genuine emergency — sparks, burning smell, fire risk — call 571-500-6637 and we will triage immediately."
          }
        }
      ]
