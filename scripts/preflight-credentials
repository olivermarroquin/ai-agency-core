#!/usr/bin/env python3
"""preflight-credentials — verify every credential a build needs in one shot.

Usage:
    python3 preflight-credentials                    # check all
    python3 preflight-credentials --scope publish    # only publish-required creds
    python3 preflight-credentials --scope research   # only research-required creds
    python3 preflight-credentials --client ev-electric-services  # per-client check

Exits 0 if all blocking creds are present; exits 1 with a status matrix + fix
commands if any are missing. Supersedes ORCH-1's GSC-only check.

Never prints secret values.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

SECRETS_DIR = Path.home() / "workspace" / "second-brain-tier3" / "automation" / "secrets"
SCRIPTS_DIR = Path(__file__).resolve().parent

# Credential registry: (name, check_func, scope_tags, blocking)
# scope_tags: which --scope values require this cred
# blocking: if True, missing = exit 1


def _check_key_file(filename: str) -> tuple[str, str]:
    """Check a vending-machine .key file exists and is non-empty."""
    path = SECRETS_DIR / filename
    if not path.exists():
        return "MISSING", f"echo -n 'VALUE' > {path} && chmod 600 {path}"
    content = path.read_text().strip()
    if not content:
        return "EMPTY", f"echo -n 'VALUE' > {path}"
    return "OK", ""


def _check_wp_password(client_slug: str) -> tuple[str, str]:
    """Check per-client WP app password (.key file, then markdown fallback)."""
    key_file = SECRETS_DIR / f"wp-app-password-{client_slug}.key"
    if key_file.exists() and key_file.read_text().strip():
        return "OK", ""
    # Check markdown fallback
    md_path = Path.home() / "workspace" / "second-brain-tier3" / "clients" / client_slug / "credentials.md"
    if md_path.exists():
        return "OK (md fallback)", ""
    return "MISSING", f"echo -n 'PASSWORD' > {key_file} && chmod 600 {key_file}"


def _check_gsc_adc() -> tuple[str, str]:
    """Check GSC Application Default Credentials (user-level, expires).

    Org policy (iam.disableServiceAccountKeyCreation) blocks SA JSON keys on
    keelworks-seo-automation, so ADC is the only path. Oliver is Owner on
    URL-prefix GSC properties for both clients.
    """
    adc_path = Path.home() / ".config" / "gcloud" / "application_default_credentials.json"
    if not adc_path.exists():
        return "MISSING", (
            "gcloud auth application-default login \\\n"
            "    --scopes=https://www.googleapis.com/auth/cloud-platform,"
            "https://www.googleapis.com/auth/indexing\n"
            "    gcloud auth application-default set-quota-project keelworks-seo-automation"
        )
    try:
        import google.auth
        from google.auth.transport.requests import Request as GoogleAuthRequest
        creds, _ = google.auth.default(
            scopes=["https://www.googleapis.com/auth/indexing"]
        )
        creds.refresh(GoogleAuthRequest())
        quota = getattr(creds, "quota_project_id", None)
        expiry = getattr(creds, "expiry", "unknown")
        if not quota:
            return "NO QUOTA PROJECT", (
                "gcloud auth application-default set-quota-project keelworks-seo-automation"
            )
        return f"OK (ADC, expires ~{expiry})", ""
    except Exception:
        return "EXPIRED", (
            "gcloud auth application-default login \\\n"
            "    --scopes=https://www.googleapis.com/auth/cloud-platform,"
            "https://www.googleapis.com/auth/indexing"
        )


def _find_client_config(client_slug: str) -> Path | None:
    """Find the config JSON for a client slug. Handles naming variants."""
    for pattern in [f"{client_slug}.config.json", f"{client_slug.split('-')[0]}-{client_slug.split('-')[1]}.config.json" if '-' in client_slug else ""]:
        path = SCRIPTS_DIR / pattern
        if path.exists():
            return path
    # Glob fallback
    for p in SCRIPTS_DIR.glob("*.config.json"):
        try:
            data = json.loads(p.read_text())
            if data.get("client_slug") == client_slug:
                return p
        except (json.JSONDecodeError, OSError):
            continue
    return None


def _check_wp_connectivity(client_slug: str) -> tuple[str, str]:
    """Check WP REST API is reachable with the loaded credentials."""
    config_file = _find_client_config(client_slug)
    if not config_file or not config_file.exists():
        return "SKIP (no config)", ""
    try:
        config = json.loads(config_file.read_text())
        sys.path.insert(0, str(SCRIPTS_DIR))
        from _load_secrets import load_wp_app_password
        password = load_wp_app_password(config)
        import requests
        from base64 import b64encode
        auth = b64encode(f"{config['wp_username']}:{password}".encode()).decode()
        resp = requests.get(
            f"{config['wp_base_url']}/wp-json/wp/v2/pages?per_page=1",
            headers={"Authorization": f"Basic {auth}"},
            timeout=10,
        )
        if resp.status_code == 200:
            return "OK (authenticated)", ""
        return f"FAIL ({resp.status_code})", "Check WP app password + username"
    except RuntimeError as e:
        return "MISSING", str(e).split("\n")[0]
    except Exception as e:
        return f"ERROR", str(e)[:80]


def main() -> int:
    parser = argparse.ArgumentParser(description="Pre-flight credential check")
    parser.add_argument(
        "--scope", default="all",
        choices=["all", "publish", "research", "imagery"],
        help="Which credential set to check (default: all)",
    )
    parser.add_argument(
        "--client", default=None,
        help="Client slug for per-client checks (default: check all known clients)",
    )
    parser.add_argument("--json", action="store_true", help="Output as JSON")
    args = parser.parse_args()

    clients = [args.client] if args.client else ["ev-electric-services", "s-and-h-contracting"]
    scope = args.scope

    results: list[dict] = []
    has_blocking_fail = False

    # --- API keys (research + imagery scopes) ---
    if scope in ("all", "research"):
        for name, filename in [
            ("Anthropic Claude", "anthropic-claude.key"),
            ("Perplexity Sonar", "perplexity-sonar.key"),
            ("DataForSEO user", "dataforseo-username"),
            ("DataForSEO pass", "dataforseo-password"),
        ]:
            status, fix = _check_key_file(filename)
            results.append({"credential": name, "status": status, "fix": fix, "blocking": scope != "publish"})
            if status != "OK" and scope != "publish":
                has_blocking_fail = True

    if scope in ("all", "imagery"):
        for name, filename in [
            ("OpenAI", "openai.key"),
            ("Gemini", "gemini.key"),
        ]:
            status, fix = _check_key_file(filename)
            results.append({"credential": name, "status": status, "fix": fix, "blocking": False})

    if scope in ("all", "publish"):
        status, fix = _check_key_file("google-maps-embed.key")
        # Maps key is only needed for scaffolding (map embeds), not publishing
        results.append({"credential": "Google Maps Embed", "status": status, "fix": fix, "blocking": False})

    # --- Per-client credentials ---
    for client in clients:
        # WP password
        if scope in ("all", "publish"):
            status, fix = _check_wp_password(client)
            blocking = True
            results.append({"credential": f"WP password ({client})", "status": status, "fix": fix, "blocking": blocking})
            if "MISSING" in status:
                has_blocking_fail = True

        # WP connectivity (advisory — Wordfence WAF can 403 GETs even with valid creds)
        if scope in ("all", "publish"):
            status, fix = _check_wp_connectivity(client)
            results.append({"credential": f"WP API ({client})", "status": status, "fix": fix, "blocking": False})

        # GSC (shared ADC covers all clients — check once per run, not per client)
        if scope in ("all", "publish") and client == clients[0]:
            status, fix = _check_gsc_adc()
            # GSC is advisory (warning not block) per ORCH-1 design
            results.append({"credential": "GSC (ADC, all clients)", "status": status, "fix": fix, "blocking": False})

    # --- Output ---
    if args.json:
        json.dump({"results": results, "blocking_fail": has_blocking_fail}, sys.stdout, indent=2)
        print()
        return 1 if has_blocking_fail else 0

    # Table output
    print("\n  CREDENTIAL PRE-FLIGHT")
    print("  " + "=" * 72)
    for r in results:
        icon = "✓" if "OK" in r["status"] else ("✗" if r["blocking"] else "⚠")
        line = f"  {icon} {r['credential']:<35} {r['status']}"
        print(line)
        if r["fix"] and "OK" not in r["status"]:
            for fix_line in r["fix"].split("\n"):
                print(f"    → {fix_line}")
    print("  " + "=" * 72)

    if has_blocking_fail:
        print("\n  ✗ BLOCKING: fix the items above before starting the run.\n")
        return 1
    else:
        print("\n  ✓ All blocking credentials present. Ready to build.\n")
        return 0


if __name__ == "__main__":
    sys.exit(main())
